# OpenRouter (required)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model settings (optional — defaults set in code)
LLM_MODEL=anthropic/claude-opus-4-6
MAX_IMAGE_SIZE_MB=20

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://your-vercel-url.vercel.app

# HuggingFace model cache directory (optional — defaults to ~/.cache/huggingface)
# HF_HOME=/path/to/model/cache

# Saliency method: set to true to use rembg U²-Net (slower, more precise);
# false uses OpenCV spectral residual (~100 ms). Can also be toggled in
# src/config/metrics.py under the "use_heavy_saliency" key.
USE_HEAVY_SALIENCY=false

# Pre-screen uploaded images with CLIP before analysis (rejects screenshots,
# blank images, and document scans with HTTP 422). Enabled by default when
# no .env is present; set to false to accept all images unconditionally.
FRAMEIQ_PRESCREENING=false
